# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/dinesmart

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── File uploads ──────────────────────────────────────────────────────────────
# Local disk (backend/uploads/), no external service. Only needed when the
# public origin differs from CLIENT_URL below — e.g. your LAN IP in dev, to
# match mobile/.env's EXPO_PUBLIC_API_URL host.
# BACKEND_PUBLIC_URL=http://192.168.1.3:5000

# ─── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Firebase (FCM push notifications) ────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Email (Nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Hungora <noreply@hungora.com>

# ─── Twilio (SMS OTP) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# The "Web application" OAuth client ID (not the Android one) — this is the
# audience google-auth-library verifies mobile app ID tokens against. Must
# match mobile/.env EXPO_PUBLIC_GOOGLE_CLIENT_ID exactly.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── CORS Origins / Public URLs ─────────────────────────────────────────────────
# Production (single domain, path-based routing via nginx):
CLIENT_URL=https://hungora.com
ADMIN_URL=https://hungora.com/admin-panel
# Local dev — override these two in your own .env instead of editing this file:
#   CLIENT_URL=http://localhost:3001
#   ADMIN_URL=http://localhost:3002
